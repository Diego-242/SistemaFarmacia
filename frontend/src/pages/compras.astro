---
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

let proveedores: any[] = [];
let productos: any[] = [];
try {
  const [provRes, prodRes] = await Promise.all([
    fetch(`${API_URL}/api/proveedores`),
    fetch(`${API_URL}/api/productos`),
  ]);
  if (provRes.ok) proveedores = await provRes.json();
  if (prodRes.ok) productos = await prodRes.json();
} catch (e) { console.error(e); }
---

<LayoutPrincipal titulo="Compras a Proveedores">
  <main class="dashboard-container">
    <div class="dashboard-actions">
      <h2 class="page-title">Órdenes de Compra</h2>
      <button class="client-btn" id="add-compra-btn" type="button">+ Nueva Orden</button>
    </div>

    <div class="info-section">
      <p>Las órdenes de compra se crean con estado <strong>PENDIENTE</strong>. Al recibir la mercadería, se cambia a <strong>ENTREGADA</strong> y se ingresan los lotes a bodega.</p>
    </div>
  </main>

  <dialog class="client-modal" id="compra-modal">
    <form id="compra-form">
      <div class="modal-header">
        <h2>Nueva Orden de Compra</h2>
        <button class="close-btn" id="close-compra-modal" type="button">×</button>
      </div>
      <p class="modal-message" id="compra-message" role="status"></p>
      <div class="client-fields">
        <label>Proveedor<select id="compra-proveedor" required>
          <option value="">Seleccionar...</option>
          {proveedores.map((p: any) => (
            <option value={p.id}>{p.nombre}</option>
          ))}
        </select></label>
      </div>
      <div class="modal-actions">
        <button class="secondary-btn" id="cancel-compra" type="button">Cancelar</button>
        <button class="client-btn" type="submit">Crear Orden</button>
      </div>
    </form>
  </dialog>
</LayoutPrincipal>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";
  const API = `${API_URL}/api/compras`;
  const modal = document.querySelector<HTMLDialogElement>("#compra-modal")!;
  const form = document.querySelector<HTMLFormElement>("#compra-form")!;
  const msg = document.querySelector<HTMLParagraphElement>("#compra-message")!;
  const proveedorSelect = document.querySelector<HTMLSelectElement>("#compra-proveedor")!;

  function setMsg(m = "", isError = false) {
    msg.textContent = m;
    msg.classList.toggle("is-error", isError);
  }

  document.querySelector("#add-compra-btn")!.addEventListener("click", () => {
    form.reset();
    setMsg();
    modal.showModal();
  });

  ["#close-compra-modal", "#cancel-compra"].forEach(s => {
    document.querySelector(s)!.addEventListener("click", () => modal.close());
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const proveedor_id = parseInt(proveedorSelect.value);
    try {
      const r = await fetch(API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ proveedor_id }),
      });
      if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || "Error");
      const result = await r.json();
      setMsg(`Orden #${result.id} creada exitosamente (PENDIENTE)`);
      setTimeout(() => modal.close(), 1500);
    } catch (err) {
      setMsg(err instanceof Error ? err.message : "Error al crear orden", true);
    }
  });
</script>

<style>
  .dashboard-container {
    background-color: #ffffff;
    box-sizing: border-box;
    width: min(100%, 900px);
    margin: 0 auto;
    padding: 32px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .dashboard-actions { display: flex; align-items: center; justify-content: space-between; }
  .page-title { margin: 0; font-size: 1.4rem; color: #2e7d32; }
  .client-btn {
    padding: 10px 22px; background-color: #4caf50; color: white; border: none;
    border-radius: 6px; cursor: pointer; font-size: 0.95rem;
  }
  .client-btn:hover { background-color: #45a049; }
  .info-section {
    background: #e3f2fd; padding: 16px; border-radius: 8px;
    border: 1px solid #bbdefb; font-size: 0.9rem; color: #1565c0;
  }
  .info-section p { margin: 0; }
  .secondary-btn {
    padding: 10px 16px; border: 1px solid #d6ddd7; border-radius: 6px;
    background: #fff; color: #3f4b43; cursor: pointer; font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    .dashboard-container { padding: 20px; }
    .client-fields { grid-template-columns: 1fr; }
  }
</style>
